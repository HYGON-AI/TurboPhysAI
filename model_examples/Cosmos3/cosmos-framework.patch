diff --git a/examples/launch_sft_action_policy_droid_hcu.sh b/examples/launch_sft_action_policy_droid_hcu.sh
new file mode 100644
index 0000000000000000000000000000000000000000..29ee92b225a876aae8285d956df34045cf73978e
--- /dev/null
+++ b/examples/launch_sft_action_policy_droid_hcu.sh
@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+# HCU wrapper for the official Cosmos3-Nano DROID Action Policy SFT recipe.
+# One launcher covers short validation and longer runs through env overrides.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+
+# User setup: set these paths for your filesystem (or export them before launch).
+# DROID_ROOT, BASE_CHECKPOINT_PATH and WAN_VAE_PATH must point to prepared assets.
+: "${DROID_ROOT:=/root/Cosmos3/datasets/droid_plus_lerobot_640x360_20260412}"
+: "${BASE_CHECKPOINT_PATH:=/public4/opendas/DL_DATA/llm-models/Cosmos3/checkpoints/Cosmos3-Nano-DCP}"
+: "${WAN_VAE_PATH:=/public4/opendas/DL_DATA/llm-models/Cosmos3/checkpoints/wan22_vae/Wan2.2_VAE.pth}"
+: "${KEEP_RANGES_PATH:=}"  # Optional: prepared performance subset filter.
+: "${OUTPUT_ROOT:=/data/outputs/action_policy}"
+
+# Runtime defaults; override only when needed.
+# Text tokenizer follows the official recipe: Qwen/Qwen3-VL-8B-Instruct.
+# For offline use, prepare its Hugging Face cache in the training environment.
+: "${TOML_FILE:=examples/toml/sft_config/action_policy_droid_nano.toml}"
+: "${RUN_NAME:=action_policy_droid_nano_hcu_$(date +%Y%m%d_%H%M%S)}"
+: "${LOG_FILENAME:=${RUN_NAME}.log}"
+: "${HIP_VISIBLE_DEVICES:=0,1,2,3,4,5,6,7}"
+: "${MASTER_PORT:=29716}"
+: "${MAX_ITER:=70}"
+: "${MAX_SAMPLES_PER_BATCH:=8}"
+: "${NUM_WORKERS:=1}"
+: "${TORCHINDUCTOR_WORKER_START:=spawn}"
+: "${TORCHINDUCTOR_COMPILE_THREADS:=1}"
+: "${DATALOADER_BATCH_SIZE:=${MAX_SAMPLES_PER_BATCH}}"
+: "${PREFETCH_FACTOR:=2}"
+: "${DROID_MODE:=wam}"
+: "${VIDEO_BACKEND:=pyav}"
+: "${COMPILE_ENABLED:=true}"
+: "${COMPILE_DYNAMIC:=true}"
+: "${COMPILE_TOKENIZER_ENABLED:=false}"
+: "${CHECKPOINT_SAVE_ITER:=1000}"
+: "${NO_SAVE:=false}"
+: "${DCP_ASYNC_MODE_ENABLED:=false}"
+: "${PERF_RECORD_ENABLED:=true}"
+: "${PERF_WARMUP_ITERS:=10}"
+
+# The shared helper anchors TOML/checkpoint/VAE; anchor action-specific paths
+# before input checks, without changing the caller's directory prematurely.
+for _path_var in DROID_ROOT KEEP_RANGES_PATH OUTPUT_ROOT; do
+    _path_value="${!_path_var}"
+    if [[ -n "$_path_value" && "$_path_value" != /* ]]; then
+        printf -v "$_path_var" '%s' "$SCRIPT_DIR/../$_path_value"
+    fi
+done
+
+HIP_VISIBLE_DEVICES="${HIP_VISIBLE_DEVICES//[[:space:]]/}"
+if [[ -z "$HIP_VISIBLE_DEVICES" || "$HIP_VISIBLE_DEVICES" == ,* || "$HIP_VISIBLE_DEVICES" == *, || "$HIP_VISIBLE_DEVICES" == *,,* ]]; then
+    echo "ERROR: HIP_VISIBLE_DEVICES must be a comma-separated list without empty entries: $HIP_VISIBLE_DEVICES" >&2
+    exit 2
+fi
+IFS=',' read -r -a HCU_DEVICE_IDS <<< "$HIP_VISIBLE_DEVICES"
+NPROC_PER_NODE=${#HCU_DEVICE_IDS[@]}
+
+export COSMOS_TRAINING="${COSMOS_TRAINING:-true}"
+export HIP_VISIBLE_DEVICES
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+export MIOPEN_FIND_MODE="${MIOPEN_FIND_MODE:-3}"
+export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
+export PYTORCH_ALLOC_CONF="${PYTORCH_ALLOC_CONF:-expandable_segments:True}"
+export DROID_ROOT
+export TORCHINDUCTOR_WORKER_START TORCHINDUCTOR_COMPILE_THREADS
+export PERF_RECORD_ENABLED PERF_WARMUP_ITERS
+PERF_PLATFORM="hcu"
+PERF_VISIBLE_DEVICES="$HIP_VISIBLE_DEVICES"
+
+EXTRA_DATASET_CHECK='[[ -f "$DROID_ROOT/success/meta/info.json" ]] || { echo "ERROR: missing $DROID_ROOT/success/meta/info.json; prepare the Cosmos3-DROID success split first" >&2; exit 1; }
+[[ -f "$BASE_CHECKPOINT_PATH/checkpoint.json" ]] || { echo "ERROR: missing $BASE_CHECKPOINT_PATH/checkpoint.json" >&2; exit 1; }
+compgen -G "$BASE_CHECKPOINT_PATH/model/*.distcp" >/dev/null || { echo "ERROR: no DCP shards under $BASE_CHECKPOINT_PATH/model" >&2; exit 1; }'
+
+TAIL_OVERRIDES=(
+    "job.wandb_mode=disabled"
+    "job.name=${RUN_NAME}"
+    "model.config.parallelism.data_parallel_shard_degree=${NPROC_PER_NODE}"
+    "model.config.parallelism.data_parallel_replicate_degree=1"
+    "dataloader_train.max_samples_per_batch=${MAX_SAMPLES_PER_BATCH}"
+    "dataloader_train.dataloader.num_workers=${NUM_WORKERS}"
+    "+dataloader_train.dataloader.multiprocessing_context=spawn"
+    "dataloader_train.dataloader.batch_size=${DATALOADER_BATCH_SIZE}"
+    "dataloader_train.dataloader.prefetch_factor=${PREFETCH_FACTOR}"
+    "dataloader_train.dataloader.datasets.droid.dataset.mode=${DROID_MODE}"
+    "dataloader_train.dataloader.datasets.droid.dataset.video_backend=${VIDEO_BACKEND}"
+    "model.config.rectified_flow_training_config.loss_scale=10.0"
+    "trainer.seed=42"
+    "trainer.max_iter=${MAX_ITER}"
+    "model.config.compile.enabled=${COMPILE_ENABLED}"
+    "model.config.compile.compile_dynamic=${COMPILE_DYNAMIC}"
+    "trainer.callbacks.compile_tokenizer.enabled=${COMPILE_TOKENIZER_ENABLED}"
+    "checkpoint.save_iter=${CHECKPOINT_SAVE_ITER}"
+    "checkpoint.dcp_async_mode_enabled=${DCP_ASYNC_MODE_ENABLED}"
+)
+if [[ -n "$KEEP_RANGES_PATH" ]]; then
+    [[ -f "$KEEP_RANGES_PATH" ]] || { echo "ERROR: KEEP_RANGES_PATH not found: $KEEP_RANGES_PATH" >&2; exit 1; }
+    TAIL_OVERRIDES+=(
+        "dataloader_train.dataloader.datasets.droid.dataset.use_filter_dict=true"
+        "dataloader_train.dataloader.datasets.droid.dataset.filter_dict_path=${KEEP_RANGES_PATH}"
+    )
+fi
+case "$NO_SAVE" in
+    true)
+        TAIL_OVERRIDES+=("checkpoint.type._target_=cosmos_framework.checkpoint.load_only.LoadOnlyDistributedCheckpointer")
+        ;;
+    false) ;;
+    *) echo "ERROR: NO_SAVE must be true or false" >&2; exit 2 ;;
+esac
+TAIL_OVERRIDES+=("$@")
+
+declare -A _seen_devices=()
+for _device in "${HCU_DEVICE_IDS[@]}"; do
+    if [[ ! "$_device" =~ ^[0-9]+$ || -n "${_seen_devices[$_device]:-}" ]]; then
+        echo "ERROR: HIP_VISIBLE_DEVICES requires distinct numeric device IDs" >&2
+        exit 2
+    fi
+    _seen_devices[$_device]=1
+done
+
+echo ">>> Inductor workers / compile threads: ${TORCHINDUCTOR_WORKER_START} / ${TORCHINDUCTOR_COMPILE_THREADS}"
+echo ">>> HCU devices: ${HIP_VISIBLE_DEVICES}"
+echo ">>> Processes per node / FSDP shard degree: ${NPROC_PER_NODE}"
+echo ">>> Max iterations: ${MAX_ITER}"
+echo ">>> Max samples per packed batch: ${MAX_SAMPLES_PER_BATCH}"
+echo ">>> Dataloader batch / workers / prefetch: ${DATALOADER_BATCH_SIZE} / ${NUM_WORKERS} / ${PREFETCH_FACTOR}"
+echo ">>> DROID mode / video backend: ${DROID_MODE} / ${VIDEO_BACKEND}"
+echo ">>> Model compile / dynamic / VAE compile: ${COMPILE_ENABLED} / ${COMPILE_DYNAMIC} / ${COMPILE_TOKENIZER_ENABLED}"
+echo ">>> Disposable performance run (no checkpoint writes): ${NO_SAVE}"
+echo ">>> Async DCP save: ${DCP_ASYNC_MODE_ENABLED}"
+if [[ -n "$KEEP_RANGES_PATH" ]]; then
+    echo ">>> DROID keep-ranges filter: ${KEEP_RANGES_PATH}"
+fi
+
+source "$SCRIPT_DIR/_sft_launcher_common.sh"
