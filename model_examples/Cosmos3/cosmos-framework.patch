+"""Build actual training configs without initializing a model or downloading assets."""
+
+import os
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import test_launcher
+
+from cosmos_framework.checkpoint.dcp import DistributedCheckpointer
+from cosmos_framework.checkpoint.load_only import LoadOnlyDistributedCheckpointer
+from cosmos_framework.configs.toml_config.sft_config import load_experiment_from_toml
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class ConfigTest(unittest.TestCase):
+    def test_droid_overrides_and_normal_checkpoint_default(self):
+        with patch.dict(
+            os.environ,
+            {"DROID_ROOT": "/unused/data", "BASE_CHECKPOINT_PATH": "/unused/dcp", "WAN_VAE_PATH": "/unused/vae.pth"},
+        ):
+            cfg = load_experiment_from_toml(
+                str(ROOT / "examples/toml/sft_config/action_policy_droid_nano.toml"),
+                extra_overrides=[
+                    "dataloader_train.dataloader.datasets.droid.dataset.video_backend=pyav",
+                    "dataloader_train.dataloader.batch_size=8",
+                    "dataloader_train.dataloader.num_workers=0",
+                    "dataloader_train.dataloader.prefetch_factor=4",
+                ],
+            )
+        loader = cfg.dataloader_train.dataloader
+        self.assertEqual(loader.datasets.droid.dataset.mode, "wam")
+        self.assertEqual(loader.datasets.droid.dataset.video_backend, "pyav")
+        self.assertEqual(loader.batch_size, 8)
+        self.assertNotIn("multiprocessing_context", loader)
+        self.assertNotIn("LoadOnly", str(cfg.checkpoint.type))
+
+    def test_complete_launcher_arguments_compose(self):
+        launcher = test_launcher.LauncherTest()
+        launcher.setUp()
+        self.addCleanup(launcher.doCleanups)
+        result = launcher.launch()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        arguments = launcher.capture()["args"]
+        overrides = arguments[arguments.index("--") + 1 :]
+        with patch.dict(os.environ, launcher.env):
+            cfg = load_experiment_from_toml(
+                str(ROOT / "examples/toml/sft_config/action_policy_droid_nano.toml"),
+                extra_overrides=overrides,
+            )
+        self.assertEqual(cfg.model.config.vlm_config.tokenizer.pretrained_model_name, "Qwen/Qwen3-VL-8B-Instruct")
+        self.assertEqual(cfg.dataloader_train.dataloader.datasets.droid.dataset.mode, "wam")
+        self.assertEqual(cfg.dataloader_train.dataloader.multiprocessing_context, "spawn")
+
+    def test_load_only_preserves_load_and_skips_save(self):
+        self.assertIs(LoadOnlyDistributedCheckpointer.load, DistributedCheckpointer.load)
+        checkpointer = LoadOnlyDistributedCheckpointer.__new__(LoadOnlyDistributedCheckpointer)
+        # No initializer state or writable output is required to skip a save.
+        checkpointer.save(None, None, None, None, iteration=70)
+        with patch.dict(
+            os.environ,
+            {"DROID_ROOT": "/unused/data", "BASE_CHECKPOINT_PATH": "/unused/dcp", "WAN_VAE_PATH": "/unused/vae.pth"},
+        ):
+            cfg = load_experiment_from_toml(
+                str(ROOT / "examples/toml/sft_config/action_policy_droid_nano.toml"),
+                extra_overrides=[
+                    "checkpoint.type._target_=cosmos_framework.checkpoint.load_only.LoadOnlyDistributedCheckpointer"
+                ],
+            )
+        self.assertIn("LoadOnlyDistributedCheckpointer", str(cfg.checkpoint.type))
+
+
+if __name__ == "__main__":
+    unittest.main()
