+import importlib.util
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import pyarrow as pa
+import pyarrow.parquet as pq
+
+spec = importlib.util.spec_from_file_location(
+    "prepare_subset", Path(__file__).resolve().parents[2] / "examples/prepare_droid_perf_subset.py"
+)
+subset = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(subset)
+
+
+class SubsetTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.source = Path(self.tmp.name) / "source"
+        self.output = Path(self.tmp.name) / "output"
+        meta = self.source / "meta/episodes/chunk-000"
+        meta.mkdir(parents=True)
+        (self.source / "meta/info.json").write_text("{}")
+        rows = []
+        for index in range(10):
+            row = {
+                "episode_index": index,
+                "episode_id": f"episode-{index}",
+                "length": 200,
+                "data/chunk_index": 0,
+                "data/file_index": 0,
+            }
+            for camera in subset.CAMERAS:
+                row[f"videos/{camera}/chunk_index"] = 0
+                row[f"videos/{camera}/file_index"] = 0
+            rows.append(row)
+        pq.write_table(pa.Table.from_pylist(rows), meta / "file-000.parquet")
+        for path in subset.payload_paths(self.source, rows[0]):
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(b"payload fixture")
+
+    def test_complete_payload_filter_and_no_overwrite(self):
+        subset.prepare_subset(self.source, self.output, 8)
+        manifest = json.loads((self.output / "subset_manifest.json").read_text())
+        self.assertEqual(manifest["episode_indices"], list(range(8)))
+        self.assertTrue(manifest["filter_required"])
+        ranges = json.loads((self.output / manifest["keep_ranges_path"]).read_text())
+        self.assertEqual(len(ranges), 8)
+        self.assertTrue(all(value == [[0, 200]] for value in ranges.values()))
+        for item in manifest["payloads"]:
+            self.assertEqual((self.output / "success" / item["path"]).read_bytes(), b"payload fixture")
+        with self.assertRaises(FileExistsError):
+            subset.prepare_subset(self.source, self.output, 8)
+
+    def test_missing_payload_does_not_create_output(self):
+        next((self.source / "videos").rglob("*.mp4")).unlink()
+        with self.assertRaises(FileNotFoundError):
+            subset.prepare_subset(self.source, self.output, 8)
+        self.assertFalse(self.output.exists())
+
+    def test_insufficient_episodes(self):
+        with self.assertRaises(ValueError):
+            subset.prepare_subset(self.source, self.output, 11)
+        self.assertFalse(self.output.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/wan_vae_clean_fused_op_test.py b/tests/wan_vae_clean_fused_op_test.py
