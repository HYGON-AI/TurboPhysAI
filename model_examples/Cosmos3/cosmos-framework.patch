+# Copyright 2026 Hygon Information Technology Co., Ltd.
+# SPDX-License-Identifier: OpenMDW-1.1
+
+import torch
+from torch import nn
+
+from cosmos_framework.utils.memory_format import apply_channels_last_conv_weights, to_channels_last
+
+
+def test_to_channels_last_is_disabled_on_non_hip(monkeypatch) -> None:
+    monkeypatch.setattr(torch.version, "hip", None)
+    tensor = torch.randn(2, 3, 4, 5)
+
+    converted = to_channels_last(tensor)
+
+    assert converted is tensor
+
+
+def test_to_channels_last_handles_2d_and_3d_convolution_inputs(monkeypatch) -> None:
+    monkeypatch.setattr(torch.version, "hip", "6.0")
+    tensor_2d = torch.randn(2, 3, 4, 5)
+    tensor_3d = torch.randn(2, 3, 4, 5, 6)
+
+    converted_2d = to_channels_last(tensor_2d)
+    converted_3d = to_channels_last(tensor_3d)
+
+    assert converted_2d.is_contiguous(memory_format=torch.channels_last)
+    assert converted_3d.is_contiguous(memory_format=torch.channels_last_3d)
+
+
+def test_apply_channels_last_conv_weights_only_changes_convolutions(monkeypatch) -> None:
+    monkeypatch.setattr(torch.version, "hip", "6.0")
+    module = nn.Sequential(
+        nn.Conv2d(3, 4, kernel_size=3),
+        nn.Conv3d(3, 4, kernel_size=3),
+        nn.Linear(4, 5),
+    )
+
+    counts = apply_channels_last_conv_weights(module)
+
+    assert counts == (1, 1)
+    assert module[0].weight.is_contiguous(memory_format=torch.channels_last)
+    assert module[1].weight.is_contiguous(memory_format=torch.channels_last_3d)
