index 0000000000000000000000000000000000000000..63bb8d086d568a03ebd8d40afb2354a3447255b7
--- /dev/null
+++ b/tests/action_hcu/test_decoder_cache.py
@@ -0,0 +1,85 @@
+"""Decoder cache lifetime regression, including a real spawned process."""
+
+import io
+import multiprocessing
+import os
+import unittest
+from collections import OrderedDict
+from unittest.mock import patch
+
+from cosmos_framework.data.generator.action.datasets import cosmos3_action_lerobot as action
+
+
+def spawned_cache_probe(queue):
+    import lerobot.datasets.video_utils as video_utils
+
+    # Simulate an already-unpickled dataset: its constructor must not be needed.
+    dataset = action.BaseActionLeRobotDataset.__new__(action.BaseActionLeRobotDataset)
+    dataset._datasets = ["already loaded"]
+    dataset._loaded_lru = OrderedDict({0: None})
+    value = dataset._get_dataset(0)
+    queue.put(
+        (value, action._decoder_cache_pid, isinstance(video_utils._default_decoder_cache, action._LRUVideoDecoderCache))
+    )
+
+
+class DecoderCacheTest(unittest.TestCase):
+    def test_spawn_installs_cache_on_access(self):
+        action._patch_decoder_cache()
+        ctx = multiprocessing.get_context("spawn")
+        queue = ctx.Queue()
+        child = ctx.Process(target=spawned_cache_probe, args=(queue,))
+        child.start()
+        try:
+            value, pid, patched = queue.get(timeout=120)
+            child.join(timeout=20)
+            self.assertEqual(child.exitcode, 0)
+            self.assertEqual(value, "already loaded")
+            self.assertNotEqual(pid, os.getpid())
+            self.assertTrue(patched)
+            self.assertEqual(action._decoder_cache_pid, os.getpid())
+        finally:
+            if child.is_alive():
+                child.terminate()
+                child.join()
+            queue.close()
+
+    def test_lru_eviction_reuse_and_clear(self):
+        handles = []
+
+        def opened(_):
+            handle = io.BytesIO(b"video")
+            handles.append(handle)
+            return handle
+
+        cache = action._LRUVideoDecoderCache(max_size=2)
+        with (
+            patch("fsspec.open", side_effect=opened),
+            patch.object(action, "create_video_decoder", side_effect=lambda *a, **kw: object()),
+        ):
+            first = cache.get_decoder("a")
+            cache.get_decoder("b")
+            self.assertIs(cache.get_decoder("a"), first)
+            cache.get_decoder("c")
+            self.assertFalse(handles[0].closed)
+            self.assertTrue(handles[1].closed)
+            self.assertEqual(cache.size(), 2)
+            cache.clear()
+            self.assertTrue(all(h.closed for h in handles))
+            self.assertEqual(cache.size(), 0)
+
+    def test_failed_decoder_closes_file(self):
+        handle = io.BytesIO(b"bad video")
+        cache = action._LRUVideoDecoderCache()
+        with (
+            patch("fsspec.open", return_value=handle),
+            patch.object(action, "create_video_decoder", side_effect=RuntimeError("bad video")),
+        ):
+            with self.assertRaisesRegex(RuntimeError, "bad video"):
+                cache.get_decoder("bad")
+        self.assertTrue(handle.closed)
+        self.assertEqual(cache.size(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
