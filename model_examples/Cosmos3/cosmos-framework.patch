+++ b/tests/wan_vae_clean_fused_op_test.py
@@ -0,0 +1,115 @@
+"""Unit test for the pure Wan VAE fused operator in cosmos-framework-training-clear."""
+
+import os
+import sys
+from pathlib import Path
+import unittest
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from cosmos_framework.model.generator.tokenizers.fused_ops._hipdnn import (
+    canonical_ndhwc_stride,
+    conv_channels_supported,
+    fused_dtype_supported,
+    fused_ops_enabled,
+    is_canonical_ndhwc,
+    restride_canonical_ndhwc,
+    to_canonical_ndhwc,
+)
+from cosmos_framework.model.generator.tokenizers.fused_ops.concat_conv_bias import (
+    fused_causal_cache_pad_conv3d_ndhwc,
+    _new_cache,
+)
+
+
+class TestWanVAECleanFusedOp(unittest.TestCase):
+    def setUp(self):
+        self._orig_env = os.environ.get("COSMOS_WAN_VAE_CLEAN_FUSED_OP")
+
+    def tearDown(self):
+        if self._orig_env is not None:
+            os.environ["COSMOS_WAN_VAE_CLEAN_FUSED_OP"] = self._orig_env
+        else:
+            os.environ.pop("COSMOS_WAN_VAE_CLEAN_FUSED_OP", None)
+
+    def test_environment_variable_switch(self):
+        """Verify COSMOS_WAN_VAE_CLEAN_FUSED_OP controls activation."""
+        os.environ.pop("COSMOS_WAN_VAE_CLEAN_FUSED_OP", None)
+        os.environ.pop("COSMOS_WAN_VAE_FUSED_OPS", None)
+        self.assertFalse(fused_ops_enabled())
+
+        for false_val in ("0", "false", "off", "no"):
+            os.environ["COSMOS_WAN_VAE_CLEAN_FUSED_OP"] = false_val
+            self.assertFalse(fused_ops_enabled())
+
+        for true_val in ("1", "true", "yes", "on"):
+            os.environ["COSMOS_WAN_VAE_CLEAN_FUSED_OP"] = true_val
+            self.assertTrue(fused_ops_enabled())
+
+    def test_channel_whitelist(self):
+        """Stem (C_in=12) must be excluded; core channels {160, 320, 640} must be accepted."""
+        # Stem: must return False to avoid the 15.5x wg64x64_tt4x4 penalty
+        self.assertFalse(conv_channels_supported(12, 160))
+        self.assertFalse(conv_channels_supported(12, 12))
+
+        # Non-16-byte aligned or unsupported channels
+        self.assertFalse(conv_channels_supported(15, 160))
+        self.assertFalse(conv_channels_supported(64, 64))
+        self.assertFalse(conv_channels_supported(128, 128))
+
+        # Core channels
+        self.assertTrue(conv_channels_supported(160, 160))
+        self.assertTrue(conv_channels_supported(160, 320))
+        self.assertTrue(conv_channels_supported(320, 320))
+        self.assertTrue(conv_channels_supported(320, 640))
+        self.assertTrue(conv_channels_supported(640, 640))
+        self.assertTrue(conv_channels_supported(640, 16))
+
+    def test_stride_and_canonicalization(self):
+        """Verify NDHWC stride calculation and tensor canonicalization."""
+        shape = (1, 160, 4, 8, 8)
+        expected_stride = canonical_ndhwc_stride(shape)
+        # [C*T*H*W, 1, H*W*C, W*C, C]
+        c, t, h, w = 160, 4, 8, 8
+        self.assertEqual(expected_stride, (c * t * h * w, 1, h * w * c, w * c, c))
+
+        x = torch.randn(shape).contiguous(memory_format=torch.channels_last_3d)
+        canon_x = to_canonical_ndhwc(x)
+        self.assertTrue(is_canonical_ndhwc(canon_x))
+
+        # Test restride for [1, C, 1, 1, 1] bias view
+        bias = torch.randn(1, 160, 1, 1, 1)
+        restrided_bias = restride_canonical_ndhwc(bias)
+        self.assertTrue(is_canonical_ndhwc(restrided_bias))
+
+    def test_reference_fallback_correctness(self):
+        """When hipDNN is not available (e.g. on CPU/CUDA fallback), reference matches PyTorch."""
+        os.environ["COSMOS_WAN_VAE_CLEAN_FUSED_OP"] = "0"
+        torch.manual_seed(42)
+
+        B, C, T, H, W = 1, 160, 4, 8, 8
+        x = torch.randn(B, C, T, H, W).contiguous(memory_format=torch.channels_last_3d)
+        cache = torch.randn(B, C, 2, H, W).contiguous(memory_format=torch.channels_last_3d)
+        weight = torch.randn(C, C, 3, 3, 3).contiguous(memory_format=torch.channels_last_3d)
+        bias = torch.randn(C)
+
+        out, new_cache = fused_causal_cache_pad_conv3d_ndhwc(
+            x, cache, weight, bias,
+            pre_padding=(2, 1, 1),
+            post_padding=(0, 1, 1),
+        )
+
+        # Baseline calculation:
+        # cache_t = 2, pre_padding = (2 - 2, 1, 1) = (0, 1, 1)
+        cat_x = torch.cat([cache, x], dim=2)
+        padded_x = F.pad(cat_x, (1, 1, 1, 1, 0, 0))
+        ref_out = F.conv3d(padded_x, weight, bias, stride=(1, 1, 1), padding=0)
+
+        torch.testing.assert_close(out, ref_out.contiguous(memory_format=torch.channels_last_3d))
+        torch.testing.assert_close(new_cache, x[:, :, -2:, :, :].contiguous(memory_format=torch.channels_last_3d))
+
+
+if __name__ == "__main__":
+    unittest.main()
