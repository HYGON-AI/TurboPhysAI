+#!/usr/bin/env python3
+"""Run official Cosmos Framework inference with local asset paths.
+
+This launcher performs only local asset path validation and routes local resources
+(Video VAE, Sound Tokenizer AVAE, Processor, Guardrails) to user-specified local directories.
+All configurations and inference logic strictly adhere to NVIDIA upstream defaults.
+"""
+from __future__ import annotations
+
+import os
+import runpy
+import shutil
+import sys
+import time
+from pathlib import Path
+
+
+def _prepare_local_sound_tokenizer(local_sound_tokenizer: Path) -> Path:
+    """Ensure legacy AVAE ckpt/json expected by native loader are materialized from local safetensors."""
+    legacy_ckpt = local_sound_tokenizer / "avae_48k_noncausal_25hz_64ch.ckpt"
+    legacy_json = local_sound_tokenizer / "avae_48k_noncausal_25hz_64ch.json"
+    if legacy_ckpt.exists() and legacy_json.exists():
+        return local_sound_tokenizer
+
+    from cosmos_framework.inference.common.checkpoints import _materialize_avae_ckpt
+
+    cache_dir = Path(__file__).resolve().parents[1] / "outputs" / "sound_tokenizer_cache"
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    if (cache_dir / "avae_48k_noncausal_25hz_64ch.ckpt").exists() and (cache_dir / "avae_48k_noncausal_25hz_64ch.json").exists():
+        return cache_dir
+
+    rank = int(os.environ.get("RANK", "0"))
+    if rank == 0:
+        for name in ("config.json", "diffusion_pytorch_model.safetensors", "model.safetensors"):
+            src = local_sound_tokenizer / name
+            if not src.exists():
+                continue
+            dst = cache_dir / name
+            tmp = cache_dir / f".{name}.tmp"
+            shutil.copyfile(src, tmp)
+            os.replace(tmp, dst)
+        _materialize_avae_ckpt(str(cache_dir))
+    else:
+        deadline = time.monotonic() + 180.0
+        while not (
+            (cache_dir / "avae_48k_noncausal_25hz_64ch.ckpt").exists()
+            and (cache_dir / "avae_48k_noncausal_25hz_64ch.json").exists()
+        ):
+            if time.monotonic() >= deadline:
+                raise TimeoutError(f"Timed out waiting for AVAE cache: {cache_dir}")
+            time.sleep(0.5)
+    return cache_dir
+
+
+def parse_and_validate_custom_args() -> tuple[Path | None, Path | None, Path | None, Path | None, Path | None, Path | None]:
+    """Parse custom asset path arguments from CLI / environment, and validate their existence."""
+    vae_path: str | None = os.environ.get("WAN_VAE_PATH")
+    sound_tokenizer_dir: str | None = os.environ.get("SOUND_TOKENIZER_DIR")
+    processor_dir: str | None = os.environ.get("PROCESSOR_DIR")
+    guardrail_path: str | None = os.environ.get("COSMOS_GUARDRAIL1_PATH")
+    qwen3guard_path: str | None = os.environ.get("COSMOS_QWEN3GUARD_PATH")
+    checkpoint_path: str | None = os.environ.get("CHECKPOINT_PATH")
+
+    filtered_argv = [sys.argv[0]]
+    idx = 1
+    while idx < len(sys.argv):
+        arg = sys.argv[idx]
+        if arg == "--vae-path" and idx + 1 < len(sys.argv):
+            vae_path = sys.argv[idx + 1]
+            idx += 2
+        elif arg.startswith("--vae-path="):
+            vae_path = arg.split("=", 1)[1]
+            idx += 1
+        elif arg == "--sound-tokenizer-dir" and idx + 1 < len(sys.argv):
+            sound_tokenizer_dir = sys.argv[idx + 1]
+            idx += 2
+        elif arg.startswith("--sound-tokenizer-dir="):
+            sound_tokenizer_dir = arg.split("=", 1)[1]
+            idx += 1
+        elif arg == "--processor-dir" and idx + 1 < len(sys.argv):
+            processor_dir = sys.argv[idx + 1]
+            idx += 2
+        elif arg.startswith("--processor-dir="):
+            processor_dir = arg.split("=", 1)[1]
+            idx += 1
+        elif arg == "--guardrail-path" and idx + 1 < len(sys.argv):
+            guardrail_path = sys.argv[idx + 1]
+            idx += 2
+        elif arg.startswith("--guardrail-path="):
+            guardrail_path = arg.split("=", 1)[1]
+            idx += 1
+        elif arg == "--qwen3guard-path" and idx + 1 < len(sys.argv):
+            qwen3guard_path = sys.argv[idx + 1]
+            idx += 2
+        elif arg.startswith("--qwen3guard-path="):
+            qwen3guard_path = arg.split("=", 1)[1]
+            idx += 1
+        else:
+            if arg == "--checkpoint-path" and idx + 1 < len(sys.argv):
+                checkpoint_path = sys.argv[idx + 1]
+            elif arg.startswith("--checkpoint-path="):
+                checkpoint_path = arg.split("=", 1)[1]
+            filtered_argv.append(arg)
+            idx += 1
+
+    sys.argv[:] = filtered_argv
+
+    vae_p = Path(vae_path).expanduser().resolve() if vae_path else None
+    proc_p = Path(processor_dir).expanduser().resolve() if processor_dir else None
+    guard_p = Path(guardrail_path).expanduser().resolve() if guardrail_path else None
+    qwen_p = Path(qwen3guard_path).expanduser().resolve() if qwen3guard_path else None
+    ckpt_p = Path(checkpoint_path).expanduser().resolve() if checkpoint_path else None
+
+    # 若未显式传入 sound_tokenizer_dir，尝试从已有的 processor 或 checkpoint 目录查找
+    sound_p: Path | None = None
+    if sound_tokenizer_dir:
+        sound_p = Path(sound_tokenizer_dir).expanduser().resolve()
+    elif proc_p is not None and (proc_p / "sound_tokenizer").is_dir():
+        sound_p = (proc_p / "sound_tokenizer").resolve()
+    elif ckpt_p is not None and (ckpt_p / "sound_tokenizer").is_dir():
+        sound_p = (ckpt_p / "sound_tokenizer").resolve()
+    elif ckpt_p is not None and (ckpt_p.parent / "Cosmos3-Nano" / "sound_tokenizer").is_dir():
+        sound_p = (ckpt_p.parent / "Cosmos3-Nano" / "sound_tokenizer").resolve()
+
+    # 路径存在性校验
+    errors = []
+    if ckpt_p is not None and not ckpt_p.exists():
+        errors.append(f"Checkpoint 路径不存在: {ckpt_p}")
+    if vae_p is not None and (not vae_p.exists() or not vae_p.is_file()):
+        errors.append(f"VAE 文件不存在: {vae_p}")
+    if sound_p is not None and (not sound_p.exists() or not sound_p.is_dir()):
+        errors.append(f"Sound Tokenizer 目录不存在: {sound_p}")
+    if proc_p is not None and (not proc_p.exists() or not proc_p.is_dir()):
+        errors.append(f"Processor 目录不存在: {proc_p}")
+    if guard_p is not None and (not guard_p.exists() or not guard_p.is_dir()):
+        errors.append(f"Guardrail1 目录不存在: {guard_p}")
+    if qwen_p is not None and (not qwen_p.exists() or not qwen_p.is_dir()):
+        errors.append(f"Qwen3Guard 目录不存在: {qwen_p}")
+
+    if errors:
+        raise FileNotFoundError("[本地资产校验失败] 检测到以下路径错误:\n  - " + "\n  - ".join(errors))
+
+    return vae_p, sound_p, proc_p, guard_p, qwen_p, ckpt_p
+
+
+def setup_local_tokenizers(vae_path: Path | None, sound_tokenizer_dir: Path | None) -> None:
+    """Route Video VAE and Sound Tokenizer downloads to local files without invoking uvx or external network."""
+    if vae_path is None and sound_tokenizer_dir is None:
+        return
+
+    import cosmos_framework.utils.checkpoint_db as checkpoint_db
+
+    materialized_sound: Path | None = None
+    if sound_tokenizer_dir is not None and sound_tokenizer_dir.is_dir():
+        materialized_sound = _prepare_local_sound_tokenizer(sound_tokenizer_dir)
+
+    original_download = checkpoint_db.download_checkpoint_v2
+
+    def download_checkpoint_v2_local(uri: str, *, check_exists: bool = True) -> str:
+        if vae_path is not None and uri.endswith("pretrained/tokenizers/video/wan2pt2/Wan2.2_VAE.pth"):
+            return str(vae_path)
+        if materialized_sound is not None and uri.endswith("pretrained/tokenizers/audio/avae"):
+            return str(materialized_sound)
+        return original_download(uri, check_exists=check_exists)
+
+    checkpoint_db.download_checkpoint_v2 = download_checkpoint_v2_local
+
+
+def setup_local_processor(processor_dir: Path | None) -> None:
+    """Route processor / tokenizer download to local directory."""
+    if processor_dir is None:
+        return
+    import cosmos_framework.data.generator.processors as processors
+    import cosmos_framework.configs.base.defaults.reasoner as reasoner_defaults
+
+    original_build_processor = processors.build_processor
+    original_build_processor_lazy = processors.build_processor_lazy
+    original_create_qwen2_tokenizer = reasoner_defaults.create_qwen2_tokenizer_with_download
+
+    def build_processor_local(tokenizer_type: str, *args, **kwargs):
+        if not Path(tokenizer_type).is_dir():
+            tokenizer_type = str(processor_dir)
+        return original_build_processor(tokenizer_type, *args, **kwargs)
+
+    def build_processor_lazy_local(*args, repository=None, revision=None, subdir="", **kwargs):
+        local_path = processor_dir / subdir if subdir else processor_dir
+        if local_path.is_dir() and (repository is not None or args):
+            return original_build_processor(str(local_path), **kwargs)
+        return original_build_processor_lazy(*args, repository=repository, revision=revision, subdir=subdir, **kwargs)
+
+    def create_qwen2_tokenizer_local(pretrained_model_name: str, config_variant: str, *args, **kwargs):
+        from cosmos_framework.data.generator.processors.qwen3vl_processor import Qwen3VLProcessor
+        if pretrained_model_name.startswith("Qwen/Qwen3-VL-"):
+            return Qwen3VLProcessor(str(processor_dir))
+        return original_create_qwen2_tokenizer(pretrained_model_name, config_variant, *args, **kwargs)
+
+    processors.build_processor = build_processor_local
+    processors.build_processor_lazy = build_processor_lazy_local
+    reasoner_defaults.create_qwen2_tokenizer_with_download = create_qwen2_tokenizer_local
+
+
+def setup_local_guardrails(guardrail_path: Path | None, qwen3guard_path: Path | None) -> None:
+    """Route Guardrail checkpoints to local directories."""
+    if guardrail_path is not None:
+        from cosmos_framework.auxiliary.guardrail.common.core import GUARDRAIL1_CHECKPOINT
+        GUARDRAIL1_CHECKPOINT._path = str(guardrail_path)
+
+    if qwen3guard_path is not None:
+        import torch
+        from transformers import AutoModelForCausalLM, AutoTokenizer
+        from cosmos_framework.auxiliary.guardrail.qwen3guard import qwen3guard
+
+        def qwen3guard_init_local(self, offload_model_to_cpu: bool = True) -> None:
+            self.offload_model = offload_model_to_cpu
+            self.dtype = torch.bfloat16
+            self.model = AutoModelForCausalLM.from_pretrained(
+                str(qwen3guard_path),
+                local_files_only=True,
+                attn_implementation="eager",
+            )
+            self.tokenizer = AutoTokenizer.from_pretrained(str(qwen3guard_path), local_files_only=True)
+            device = "cpu" if offload_model_to_cpu else "cuda"
+            self.model = self.model.to(device, dtype=self.dtype).eval()
+
+        qwen3guard.Qwen3Guard.__init__ = qwen3guard_init_local
+
+
+def patch_python310_compat() -> None:
+    """Python 3.10 environment compatibility shims (contextlib.chdir, huggingface_hub offline)."""
+    import contextlib
+    if not hasattr(contextlib, "chdir"):
+        @contextlib.contextmanager
+        def chdir(path):
+            old_cwd = os.getcwd()
+            os.chdir(path)
+            try:
+                yield
+            finally:
+                os.chdir(old_cwd)
+
+        contextlib.chdir = chdir  # type: ignore[attr-defined]
+
+    try:
+        import huggingface_hub
+        if not hasattr(huggingface_hub, "is_offline_mode"):
+            def is_offline_mode() -> bool:
+                return os.environ.get("HF_HUB_OFFLINE", "1").upper() in {"1", "ON", "YES", "TRUE"}
+
+            huggingface_hub.is_offline_mode = is_offline_mode  # type: ignore[attr-defined]
+    except ImportError:
+        pass
+
+
+def setup_checkpoint_config() -> None:
+    """Ensure local checkpoints with config.json pass config_file without requiring Hydra experiment inference."""
+    from cosmos_framework.inference.common.args import (
+        CheckpointOverrides,
+        ConfigFileType,
+        DEFAULT_CONFIG_FILE,
+    )
+
+    original_build_checkpoint = CheckpointOverrides._build_checkpoint
+
+    def _build_checkpoint_patched(self, checkpoints):
+        ckpt_path = Path(self.checkpoint_path).expanduser().resolve()
+        candidate = None
+        if (ckpt_path / "model" / "config.json").is_file():
+            candidate = ckpt_path / "model" / "config.json"
+        elif (ckpt_path / "config.json").is_file():
+            candidate = ckpt_path / "config.json"
+
+        if candidate is not None and (self.config_file == DEFAULT_CONFIG_FILE or not self.config_file):
+            self.config_file = str(candidate)
+            self.config_file_type = ConfigFileType.JSON
+
+        original_build_checkpoint(self, checkpoints)
+
+    CheckpointOverrides._build_checkpoint = _build_checkpoint_patched
+
+
+def main() -> None:
+    # 0. 基础 Python 3.10 运行时兼容补丁（针对 contextlib.chdir / huggingface_hub）
+    patch_python310_compat()
+
+    # 1. 纯路径解析与存在性校验
+    vae_path, sound_tokenizer_dir, processor_dir, guardrail_path, qwen3guard_path, checkpoint_path = parse_and_validate_custom_args()
+
+    # 2. 纯路径重定向（解决离线环境无法从外网下载权重的问题）
+    setup_local_tokenizers(vae_path, sound_tokenizer_dir)
+    setup_local_processor(processor_dir)
+    setup_local_guardrails(guardrail_path, qwen3guard_path)
+    setup_checkpoint_config()
+
+    # 3. 运行官方推断逻辑，配置完全遵循官方设置
+    runpy.run_module("cosmos_framework.scripts.inference", run_name="__main__")
+
+
+if __name__ == "__main__":
+    main()
