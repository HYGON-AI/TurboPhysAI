+++ b/tests/wan_vae_concat_layout_test.py
@@ -0,0 +1,72 @@
+"""CPU checks for concat layout experiments; no hipDNN import required."""
+
+import importlib.util
+import unittest
+from pathlib import Path
+
+import torch
+
+path = Path(__file__).resolve().parents[1] / "cosmos_framework/model/generator/tokenizers/fused_ops/_concat_layout.py"
+spec = importlib.util.spec_from_file_location("concat_layout", path)
+layout = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(layout)
+
+
+class TestConcatLayout(unittest.TestCase):
+    def test_frozen_reuse_and_update(self):
+        cache = layout.FrozenWeightCache()
+        weight = torch.randn(4, 3, 2, 3, 3)
+        first = cache.convert(weight, False)
+        self.assertIs(first, cache.convert(weight, False))
+        self.assertNotEqual(first.data_ptr(), weight.data_ptr())
+        weight.add_(1)
+        second = cache.convert(weight, False)
+        self.assertIsNot(first, second)
+        torch.testing.assert_close(second, weight)
+        replacement = weight.clone()
+        self.assertIsNot(second, cache.convert(replacement, False))
+        torch.testing.assert_close(cache.convert(weight.double(), False), weight.double())
+
+    def test_grad_and_inference_tensor_bypass(self):
+        cache = layout.FrozenWeightCache()
+        weight = torch.randn(4, 3, 2, 3, 3, requires_grad=True)
+        cache.convert(weight, False).sum().backward()
+        torch.testing.assert_close(weight.grad, torch.ones_like(weight))
+        self.assertEqual(len(cache.entries), 0)
+        with torch.inference_mode():
+            weight = torch.randn(4, 3, 2, 3, 3)
+            torch.testing.assert_close(cache.convert(weight, False), weight)
+        self.assertEqual(len(cache.entries), 0)
+
+    def test_singleton_slice_offset_and_real_layout(self):
+        source = torch.randn(1, 3, 4, 5, 6).contiguous(memory_format=torch.channels_last_3d)
+        sliced = source[:, :, -1:]
+        result = layout.canonicalize(sliced, True)
+        self.assertEqual(result.data_ptr(), sliced.data_ptr())
+        self.assertEqual(result.storage_offset(), sliced.storage_offset())
+        self.assertEqual(result.stride(), (90, 1, 90, 18, 3))
+        torch.testing.assert_close(result, sliced)
+        self.assertNotEqual(layout.canonicalize(sliced, False).data_ptr(), sliced.data_ptr())
+        # N > 1 makes the temporal slice's batch stride meaningful: must copy.
+        source = torch.randn(2, 3, 4, 5, 6).contiguous(memory_format=torch.channels_last_3d)
+        sliced = source[:, :, -1:]
+        result = layout.canonicalize(sliced, True)
+        self.assertNotEqual(result.data_ptr(), sliced.data_ptr())
+        torch.testing.assert_close(result, sliced)
+        nchw = torch.randn(2, 3, 4, 5, 6)
+        result = layout.canonicalize(nchw, True)
+        self.assertNotEqual(result.data_ptr(), nchw.data_ptr())
+        torch.testing.assert_close(result, nchw)
+
+    def test_bound_and_already_canonical(self):
+        cache = layout.FrozenWeightCache(limit=2)
+        weights = [torch.randn(4, 3, 2, 3, 3) for _ in range(3)]
+        for weight in weights:
+            cache.convert(weight, False)
+        self.assertEqual(len(cache.entries), 2)
+        canonical = weights[0].contiguous(memory_format=torch.channels_last_3d)
+        self.assertIs(cache.convert(canonical, False), canonical)
+
+
+if __name__ == "__main__":
+    unittest.main()
