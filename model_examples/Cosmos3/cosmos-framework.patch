@@ -0,0 +1,64 @@
+"""Exercise the real rank-partitioned loader, including spawned workers."""
+
+import os
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from cosmos_framework.data.generator.joint_dataloader import RankPartitionedDataLoader
+
+
+class ProcessDataset(torch.utils.data.Dataset):
+    def __len__(self):
+        return 16
+
+    def __getitem__(self, index):
+        return {"index": index, "pid": os.getpid()}
+
+
+class LoaderTest(unittest.TestCase):
+    def build(self, workers, per_dataset=None):
+        with (
+            patch("torch.distributed.get_world_size", return_value=1),
+            patch("torch.distributed.get_rank", return_value=0),
+            patch("cosmos_framework.data.generator.joint_dataloader.instantiate", return_value=ProcessDataset()),
+        ):
+            return RankPartitionedDataLoader(
+                {"droid": {"dataset": None, "ratio": 1, "dataloader_kwargs": per_dataset or {}}},
+                batch_size=2,
+                num_workers=workers,
+                multiprocessing_context="spawn",
+                persistent_workers=True,
+                prefetch_factor=4,
+            )
+
+    def test_worker_matrix_and_second_epoch(self):
+        for workers in (0, 1, 4):
+            with self.subTest(workers=workers):
+                loader = self.build(workers)
+                try:
+                    for _ in range(2):
+                        batches = list(loader)
+                        self.assertEqual(sorted(i for b in batches for i in b["index"].tolist()), list(range(16)))
+                        pids = {pid for b in batches for pid in b["pid"].tolist()}
+                        if workers:
+                            self.assertNotIn(os.getpid(), pids)
+                            self.assertEqual(len(pids), workers)
+                        else:
+                            self.assertEqual(pids, {os.getpid()})
+                finally:
+                    iterator = loader.dataloader._iterator
+                    if iterator is not None:
+                        iterator._shutdown_workers()
+
+    def test_dataset_zero_worker_override(self):
+        loader = self.build(4, {"num_workers": 0})
+        self.assertIsNone(loader.dataloader.multiprocessing_context)
+        self.assertIsNone(loader.dataloader.prefetch_factor)
+        self.assertFalse(loader.dataloader.persistent_workers)
