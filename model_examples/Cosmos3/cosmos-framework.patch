+"""CPU-only launcher contract tests: python -m unittest discover -s tests/action_hcu."""
+
+import json
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+class LauncherTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.base = Path(self.tmp.name)
+        for name in ("data/success/meta", "dcp/model", "bin"):
+            (self.base / name).mkdir(parents=True)
+        for name in ("data/success/meta/info.json", "dcp/checkpoint.json", "dcp/model/0.distcp", "vae.pth"):
+            (self.base / name).touch()
+        runtime = self.base / "bin/torchrun"
+        runtime.write_text(
+            "#!/usr/bin/env python3\nimport json, os, sys\n"
+            'open(os.environ["CAPTURE"], "w").write(json.dumps({"args": sys.argv[1:], "env": dict(os.environ)}))\n'
+            'print("synthetic torchrun output")\nsys.exit(int(os.environ.get("FAKE_EXIT", "0")))\n'
+        )
+        runtime.chmod(0o755)
+        self.env = {
+            **os.environ,
+            "PATH": f"{self.base / 'bin'}:{os.environ['PATH']}",
+            "DROID_ROOT": str(self.base / "data"),
+            "BASE_CHECKPOINT_PATH": str(self.base / "dcp"),
+            "WAN_VAE_PATH": str(self.base / "vae.pth"),
+            "OUTPUT_ROOT": str(self.base / "output"),
+            "RUN_NAME": "contract",
+            "CAPTURE": str(self.base / "capture.json"),
+            "HIP_VISIBLE_DEVICES": "2,5",
+            "MAX_ITER": "3",
+            "PERF_RECORD_ENABLED": "true",
+        }
+
+    def launch(self, *args):
+        return subprocess.run(
+            ["bash", str(ROOT / "examples/launch_sft_action_policy_droid_hcu.sh"), *args],
+            cwd=self.base,
+            env=self.env,
+            text=True,
+            capture_output=True,
+        )
+
+    def capture(self):
+        return json.loads((self.base / "capture.json").read_text())
+
+    def test_overrides_topology_and_summary(self):
+        result = self.launch("trainer.max_iter=5")
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        args = self.capture()["args"]
+        self.assertIn("--nproc_per_node=2", args)
+        self.assertIn("model.config.parallelism.data_parallel_shard_degree=2", args)
+        self.assertIn("trainer.max_iter=3", args)
+        self.assertEqual(args[-1], "trainer.max_iter=5")
+        self.assertIn("synthetic torchrun output", (self.base / "output/logs/contract.log").read_text())
+        self.assertTrue((self.base / "output/perf/contract.json").is_file())
+
+    def test_droid_performance_config_and_overrides(self):
+        result = self.launch()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        args = self.capture()["args"]
+        for value in (
+            "dataloader_train.max_samples_per_batch=8",
+            "dataloader_train.dataloader.batch_size=8",
+            "dataloader_train.dataloader.prefetch_factor=2",
+            "dataloader_train.dataloader.num_workers=1",
+            "+dataloader_train.dataloader.multiprocessing_context=spawn",
+            "dataloader_train.dataloader.datasets.droid.dataset.mode=wam",
+            "dataloader_train.dataloader.datasets.droid.dataset.video_backend=pyav",
+        ):
+            self.assertIn(value, args)
+        self.env.update(DATALOADER_BATCH_SIZE="2", NUM_WORKERS="4", PREFETCH_FACTOR="1", VIDEO_BACKEND="torchcodec")
+        self.assertEqual(self.launch().returncode, 0)
+        args = self.capture()["args"]
+        self.assertIn("dataloader_train.dataloader.batch_size=2", args)
+        self.assertIn("dataloader_train.dataloader.num_workers=4", args)
+        self.assertIn("dataloader_train.dataloader.prefetch_factor=1", args)
+        self.assertIn("dataloader_train.dataloader.datasets.droid.dataset.video_backend=torchcodec", args)
+
+    def test_inductor_environment_is_overridable(self):
+        self.assertEqual(self.launch().returncode, 0)
+        env = self.capture()["env"]
+        self.assertEqual(env["TORCHINDUCTOR_WORKER_START"], "spawn")
+        self.assertEqual(env["TORCHINDUCTOR_COMPILE_THREADS"], "1")
+        self.assertEqual(env["MIOPEN_FIND_MODE"], "3")
+        self.env["TORCHINDUCTOR_COMPILE_THREADS"] = "2"
+        self.env["MIOPEN_FIND_MODE"] = "1"
+        self.assertEqual(self.launch().returncode, 0)
+        self.assertEqual(self.capture()["env"]["TORCHINDUCTOR_COMPILE_THREADS"], "2")
+        self.assertEqual(self.capture()["env"]["MIOPEN_FIND_MODE"], "1")
+
+    def test_model_and_vae_compile_are_independent(self):
+        self.assertEqual(self.launch().returncode, 0)
+        args = self.capture()["args"]
+        self.assertIn("model.config.compile.enabled=true", args)
+        self.assertIn("trainer.callbacks.compile_tokenizer.enabled=false", args)
+        self.env.update(COMPILE_ENABLED="false", COMPILE_TOKENIZER_ENABLED="true")
+        self.assertEqual(self.launch().returncode, 0)
+        args = self.capture()["args"]
+        self.assertIn("model.config.compile.enabled=false", args)
+        self.assertIn("trainer.callbacks.compile_tokenizer.enabled=true", args)
+
+    def test_no_save_is_opt_in(self):
+        self.assertEqual(self.launch().returncode, 0)
+        self.assertFalse(any("LoadOnly" in x for x in self.capture()["args"]))
+        self.env["NO_SAVE"] = "true"
+        self.assertEqual(self.launch().returncode, 0)
+        self.assertIn(
+            "checkpoint.type._target_=cosmos_framework.checkpoint.load_only.LoadOnlyDistributedCheckpointer",
+            self.capture()["args"],
+        )
+        self.env["NO_SAVE"] = "invalid"
+        self.assertNotEqual(self.launch().returncode, 0)
+
+    def test_relative_invocation_from_outside_repository(self):
+        script = os.path.relpath(ROOT / "examples/launch_sft_action_policy_droid_hcu.sh", self.base)
+        for key in ("DROID_ROOT", "OUTPUT_ROOT"):
+            self.env[key] = os.path.relpath(self.env[key], ROOT)
+        result = subprocess.run(["bash", script], cwd=self.base, env=self.env, text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertTrue((self.base / "output/perf/contract.json").is_file())
+
+    def test_failure_exit_survives_tee(self):
+        self.env["FAKE_EXIT"] = "17"
+        result = self.launch()
+        self.assertEqual(result.returncode, 17, result.stdout + result.stderr)
+        self.assertTrue((self.base / "output/perf/contract.json").is_file())
+
+    def test_invalid_devices_fail_before_launch(self):
+        for devices in ("0,,1", "0,0", "wrong", ",0"):
+            with self.subTest(devices=devices):
+                self.env["HIP_VISIBLE_DEVICES"] = devices
+                self.assertNotEqual(self.launch().returncode, 0)
+                self.assertFalse((self.base / "capture.json").exists())
+
+    def test_missing_input_fails_before_launch(self):
+        (self.base / "vae.pth").unlink()
+        self.assertNotEqual(self.launch().returncode, 0)
+        self.assertFalse((self.base / "capture.json").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
