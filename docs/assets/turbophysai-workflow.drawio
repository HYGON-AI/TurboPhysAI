<mxfile host="app.diagrams.net" agent="Codex" version="26.0.16">
  <diagram id="turbo_physai-workflow" name="Page-1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="install" value="&lt;b&gt;1  安装 TurboPhysAI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;使用发布镜像或 wheel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C7BD9;strokeWidth=2;fontColor=#1F3354;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;2  选择内置模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;--model &amp;lt;model&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C7BD9;strokeWidth=2;fontColor=#1F3354;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;3  启动原训练命令&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;turbo-physai run -- ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2ECFF;strokeColor=#8A67D5;strokeWidth=2;fontColor=#3D2B63;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="60" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="apply" value="&lt;b&gt;4  每个训练进程应用优化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;导入训练入口前应用 OptimizationConfig&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E5;strokeColor=#D98534;strokeWidth=2;fontColor=#633A17;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="260" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;5  开始模型训练&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;使用已应用的优化能力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#3B9B72;strokeWidth=2;fontColor=#174D39;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="training" value="&lt;b&gt;6  查看应用结果&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;通过报告确认优化状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F1;strokeColor=#3B9B72;strokeWidth=2;fontColor=#174D39;fontSize=17;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="install" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="model" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="run" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="apply" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="result" target="training"><mxGeometry relative="1" as="geometry"/></mxCell>
